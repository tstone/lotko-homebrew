Led(
  version: 1,
  timing: (
    duration: 2.0,
    cycle: Once,
  ),
  layers: [
    (
      leds: Tag("Playfield"),
      surface: Area("Playfield"),
      layer: (
        fill: (
          transform: [
            Fit("roots"),
          ],
          base: Gradient(
            stops: [
              (
                at: 0.0,
                color: Fixed(140, 255, 0, 255),
              ),
              (
                at: 1.0,
                color: Fixed(255, 180, 0, 255),
              ),
            ],
            style: Linear,
          ),
          adjust: [
