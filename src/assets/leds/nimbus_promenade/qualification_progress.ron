(
  version: 12,
  params: {
    "width": Float(0.5),
  },
  viewport: Sequence,
  timing: (
    duration: 1.25,
    cycle: Forever,
  ),
  layers: [
    (
      fill: (
        base: Solid(Fixed(255, 0, 255, 255)),
      ),
      shape: (
        transform: [
          Rotate(Track(
            keys: [
              (
                at: 0.0,
                value: 0.0,
                curve: Linear,
              ),
              (
                at: 1.25,
                value: 360.0,
                curve: Linear,
              ),
            ],
            cycle: Once,
          )),
        ],
        base: Rect(
          width: Param("width"),
          height: Fixed(1.0),
        ),
      ),
    ),
  ],
)
