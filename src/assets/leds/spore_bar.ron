(
  version: 12,
  params: {
    "color": Color(255, 255, 255, 255),
    "width": Float(2.0),
  },
  viewport: Sequence,
  layers: [
    (
      fill: (
        base: Solid(Param("color")),
      ),
      shape: (
        base: Rect(
          width: Param("width"),
          height: Fixed(1.0),
        ),
      ),
    ),
  ],
)
