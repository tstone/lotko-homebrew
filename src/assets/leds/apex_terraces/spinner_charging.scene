Led(
  version: 1,
  params: {
    "brightness": Float(1.0),
  },
  layers: [
    (
      leds: Names([
        "___child::center_spinner::0",
      ]),
      surface: Sequence,
      layer: (
        fill: (
          base: Solid(Fixed(255, 155, 0, 255)),
          adjust: [
            Brightness(Param("brightness")),
          ],
        ),
      ),
    ),
  ],
)
