(
  version: 12,
  params: {
    "color": Color(255, 255, 255, 255),
  },
  viewport: Sequence,
  timing: (
    duration: 0.75,
    cycle: Once,
  ),
  layers: [
    (
      fill: (
        base: Solid(Param("color")),
        adjust: [
          Opacity(Track(
            keys: [
              (
                at: 0.0,
                value: 1.0,
                curve: Linear,
              ),
              (
                at: 0.75,
                value: 0.0,
                curve: EaseIn,
              ),
            ],
            cycle: Once,
          )),
        ],
      ),
    ),
  ],
)
