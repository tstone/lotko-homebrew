Led(
  version: 1,
  timing: (
    duration: 1.2,
    cycle: Once,
  ),
  layers: [
    (
      leds: Every,
      z: 30,
      surface: Area("Playfield"),
      layer: (
        fill: (
          transform: [
            Fit("burst"),
          ],
          base: Gradient(
            stops: [
              (
                at: 0.0,
                color: Fixed(0, 255, 0, 255),
              ),
              (
                at: 1.0,
                color: Fixed(140, 0, 255, 255),
              ),
            ],
            space: Rgb,
            style: Linear,
          ),
          adjust: [
            Opacity(Visit(traversal: "burst", from: 0.0, to: 1.0, smooth_out: 4.0, curve_out: EaseIn)),
          ],
        ),
        graph: (
          traversals: [
            (
              name: "burst",
              from: Nearest(Fixed(3.088, 31.606)),
              algorithm: FanOut(
                to: Nearest(Fixed(10.125, 22.5)),
                angle: Fixed(120.0),
                count: Fixed(4.0),
                wander: Fixed(0.5),
              ),
              speed: Duration(Some(0.9)),
            ),
          ],
        ),
      ),
    ),
  ],
)
