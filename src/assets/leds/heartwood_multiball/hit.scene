Led(
  version: 1,
  timing: (
    duration: 0.6,
    cycle: Once,
  ),
  layers: [
    (
      leds: Tag("Playfield"),
      surface: Area("Playfield"),
      layer: (
        fill: (
          transform: [
            Fit("growth"),
          ],
          base: Gradient(
            stops: [
              (
                at: 0.0,
                color: Fixed(140, 255, 0, 255),
              ),
              (
                at: 1.0,
                color: Fixed(255, 255, 255, 255),
              ),
            ],
            style: Linear,
          ),
          adjust: [
            Opacity(Visit(traversal: "growth", from: 0.0, to: 1.0, smooth_out: 2.0, curve_out: EaseIn)),
          ],
        ),
        graph: (
          traversals: [
            (
              name: "growth",
              from: Nearest(Fixed(10.125, 2.0)),
              algorithm: Growth(
                to: Nearest(Fixed(10.125, 43.0)),
                reach: Fixed(4.0),
                density: Fixed(5.0),
                branching: Fixed(0.3),
                wander: Fixed(0.6),
              ),
              speed: Duration(None),
            ),
          ],
        ),
      ),
    ),
  ],
)
