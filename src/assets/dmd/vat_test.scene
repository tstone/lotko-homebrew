Scene(
  version: 2,
  variables: {
    // how full the vats are, which a game sets as they're drained
    "vat_level": Value("vat_level"),
  },
  values: {
    "vat_level": Float(Keyframes(
      keys: [
        (at: 0.0, value: 1.0),
        (at: 2.0, value: 1.0),
        (at: 6.0, value: 0.15, curve: EaseInOut),
        (at: 8.0, value: 0.15),
      ],
      cycle: Once,
    )),
  },
  timing: (
    // a multiple of the vats' period, so their bubbles loop without a jump
    duration: 8.0,
    cycle: Forever,
  ),
  layers: [
