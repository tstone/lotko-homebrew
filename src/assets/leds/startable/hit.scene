Led(
  version: 1,
  params: {
    "color": Color(255, 255, 255, 255),
  },
  timing: (
    duration: 0.75,
    cycle: Once,
  ),
  layers: [
    (
      leds: Tag("Playfield"),
      z: -1,
      surface: Sequence,
      layer: (
        fill: (
          base: Solid(Param("color")),
          adjust: [
            Opacity(Track(
              keys: [
                (
                  at: 0.0,
                  value: 1.0,
                  curve: Linear,
                ),
                (
                  at: 0.75,
                  value: 0.0,
                  curve: EaseIn,
                ),
              ],
              cycle: Once,
            )),
          ],
        ),
      ),
    ),
  ],
)
